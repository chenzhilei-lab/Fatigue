"""
paper_check.py v2.0 — Universal Paper Checker
==============================================
Usage: paper_check.exe [paper.tex]

Universal verification for any project:
  1. LABELS  — read output/labels.json, verify all % @source: tags
  2. NUMBERS — trace every statistical number in the paper to output/ files
  3. UNTAGGED — warn about numbers without @source tags

Requirements:
  - output/labels.json (generated by per-project generate_labels.py)
  - output/*.json + output/*.txt (script outputs)
  - Paper .tex with % @source: <key> tags

Exit code: 0 = all clear, 1 = errors found
"""

import json, re, sys, os, glob


def chdir_to_script():
    if getattr(sys, 'frozen', False):
        os.chdir(os.path.dirname(sys.executable))
    else:
        os.chdir(os.path.dirname(os.path.abspath(__file__)))


# ═══════════════════════════════════════════════════
# LAYER 1: LABEL VERIFICATION
# ═══════════════════════════════════════════════════

def load_labels():
    """Load output/labels.json. Returns None if missing."""
    path = os.path.join('output', 'labels.json')
    if not os.path.exists(path):
        return None
    with open(path, encoding='utf-8') as f:
        return json.load(f)


def extract_numbers_from_text(text):
    """Extract all numeric values from text (handles commas, LaTeX formatting)."""
    nums = []
    # Comma-separated numbers: 53,172 → 53172
    for nr in re.findall(r'[\d,]+\.?\d*(?:[eE][+-]?\d+)?', text):
        clean = nr.replace(',', '')
        try:
            nums.append(float(clean))
        except ValueError:
            pass
    # Standard floats
    for nr in re.findall(r'[\d.]+(?:[eE][+-]?\d+)?', text):
        try:
            nums.append(float(nr))
        except ValueError:
            pass
    return nums


def check_labels(paper_path, labels):
    """Verify all % @source: tags against labels.json."""
    results = {'match': 0, 'mismatch': 0, 'missing': 0, 'manual': 0, 'details': []}
    
    with open(paper_path, encoding='utf-8', errors='ignore') as f:
        lines = f.readlines()
    
    for line_no, line in enumerate(lines, 1):
        if '% @source:' not in line:
            continue
        m = re.search(r'% @source:\s*(.+)$', line)
        if not m:
            continue
        tokens = m.group(1).strip().split()
        keys = [t for t in tokens if t in labels]
        if not keys:
            continue
        
        before_tag = line.split('% @source:')[0]
        nums = extract_numbers_from_text(before_tag)
        
        for key in keys:
            expected = labels[key]['value']
            note = labels[key].get('note', '')
            
            if match_value_to_line(expected, nums):
                # Try to distinguish exact match vs manual
                if is_exact_match(expected, nums):
                    results['match'] += 1
                else:
                    results['manual'] += 1
            else:
                results['mismatch'] += 1
                results['details'].append(
                    f"Line {line_no}: {key} = ??? (expected {expected}) [{note}]")
    
    return results


def is_exact_match(expected, nums):
    """Check if any number in nums exactly matches expected."""
    if isinstance(expected, (int, float)):
        for val in nums:
            if isinstance(val, (int, float)):
                if abs(val - expected) < max(abs(expected)*0.02, 1e-10):
                    return True
    if isinstance(expected, str):
        return True  # string labels are always manual
    return False


def match_value_to_line(expected, nums):
    """Check if expected value appears in nums (any format)."""
    if isinstance(expected, str):
        return True  # qualitative labels always OK
    
    if not isinstance(expected, (int, float)):
        return False
    
    for val in nums:
        if not isinstance(val, (int, float)):
            continue
        
        # Exact/close match
        if abs(val - expected) < max(abs(expected)*0.02, 1e-10):
            return True
        
        # Percentage vs fraction (86.5 vs 0.865)
        if 0 < expected < 1:
            pct = round(expected * 100, 1)
            if abs(val - pct) < 0.3:
                return True
        
        # Reverse: fraction vs percentage (0.865 vs 86.5)
        if expected > 1 and expected < 1000:
            frac = expected / 100
            if abs(val - frac) < 0.02:
                return True
        
        # Ratio match (3.4 vs 3.447)
        if expected > 0.5 and abs(val - expected) / expected < 0.1:
            return True
        
        # Large integer match (53172 vs 53172.0)
        if expected > 100 and abs(val - expected) < 1:
            return True
        
        # Approximate match (0.15 vs 0.145)
        if abs(expected) > 0.01 and abs(val - expected) / abs(expected) < 0.05:
            return True
        
        # Mantissa match for very small values (4.2 vs 4.17e-11)
        if 0 < abs(expected) < 1e-5 and 0 < val < 100:
            exp_str = f'{expected:e}'
            mantissa = expected / (10 ** int(exp_str.split('e')[1]))
            if abs(val - mantissa) / max(val, 0.1) < 0.1:
                return True
    
    # Fallback: if line has ANY numbers, treat as manual (formatting issue)
    return len(nums) > 0


# ═══════════════════════════════════════════════════
# LAYER 2: NUMBER TRACEABILITY
# ═══════════════════════════════════════════════════

STAT_PATTERNS = [
    (r'F_?[_{(\\[]?\d*,?\d*[})\\]]?\s*[=≈]\s*([\d.]+(?:[eE][+-]?\d+)?)', 'F'),
    (r'p\s*[<>=≈]\s*([\d.]+(?:[eE][+-]?\d+)?)', 'p'),
    (r'W\s*[=≈]\s*([\d.]+)', 'W'),
    (r'Levene.*?(?:stat|W)\s*[=≈]\s*([\d.]+)', 'Levene'),
    (r'([\d.]+)\s*\\?%', 'percent'),
    (r'([\d.]+)\s*[×xX]', 'multiplier'),
]

SKIP_PATTERNS = [
    r'\\section\{', r'\\label\{', r'\\ref\{', r'\\cite\{',
    r'\\begin\{', r'\\end\{', r'\\year\{',
    r'19\d\d', r'20\d\d', r'\\frac\{',
    r'\\usepackage', r'\\documentclass',
]

STAT_CONVENTIONS = {68, 68.0, 68.3, 90, 90.0, 95, 95.0, 95.4, 99, 99.0, 99.7,
                    0.05, 0.01, 0.005, 0.001, 0.0001}


def load_source_numbers():
    """Load all numbers from output/ JSON and TXT files."""
    all_numbers = set()
    ss_pairs = []
    
    def extract_numbers(obj, path=''):
        results = []
        if isinstance(obj, (int, float)) and not isinstance(obj, bool):
            results.append((float(obj), path))
        elif isinstance(obj, dict):
            for k, v in obj.items():
                results.extend(extract_numbers(v, f'{path}.{k}'))
        elif isinstance(obj, list):
            for i, v in enumerate(obj):
                results.extend(extract_numbers(v, f'{path}[{i}]'))
        return results
    
    for jf in glob.glob('output/*.json'):
        try:
            with open(jf, encoding='utf-8') as f:
                data = json.load(f)
            for num, path in extract_numbers(data):
                if abs(num) < 1e-30 or abs(num) > 1e30:
                    continue
                for d in [0, 1, 2, 3, 4, 5]:
                    r = round(num, d)
                    all_numbers.add(r)
                    if r == int(r) and d > 0:
                        all_numbers.add(int(r))
                all_numbers.add(num)
                if 'SS' in path.upper():
                    ss_pairs.append((float(num), path))
        except (json.JSONDecodeError, IOError):
            continue
    
    for tf in glob.glob('output/*.txt'):
        try:
            with open(tf, encoding='utf-8', errors='ignore') as f:
                for n in re.findall(r'[\d.]+(?:[eE][+-]?\d+)?', f.read()):
                    try:
                        v = float(n)
                        all_numbers.add(v)
                        all_numbers.add(round(v, 2))
                        all_numbers.add(round(v, 3))
                    except ValueError:
                        continue
        except IOError:
            continue
    
    for ss_i, pi in ss_pairs:
        for ss_j, pj in ss_pairs:
            if pi == pj or ss_j == 0:
                continue
            ratio = ss_i / ss_j
            if 0 < ratio <= 1:
                all_numbers.add(round(ratio * 100, 1))
                all_numbers.add(round(ratio * 100, 0))
    
    return all_numbers


def match_number(value, label, source_numbers):
    """Check if a statistical number exists in output files."""
    if value in STAT_CONVENTIONS:
        return True
    if value in source_numbers:
        return True
    if label in ('F', 'Levene'):
        for s in source_numbers:
            if isinstance(s, (int, float)) and abs(value - s) < 0.5:
                return True
        return False
    if label in ('p', 'W', 'percent'):
        for s in source_numbers:
            if isinstance(s, (int, float)):
                if abs(value - s) / max(abs(value), abs(s), 1e-10) < 0.02:
                    return True
        return False
    for s in source_numbers:
        if isinstance(s, (int, float)):
            if abs(value - s) / max(abs(value), abs(s), 1e-10) < 0.01:
                return True
    return False


def check_numbers(paper_path, source_numbers):
    """Trace all statistical numbers to output files."""
    untraced = []
    traced = 0
    
    with open(paper_path, encoding='utf-8', errors='ignore') as f:
        lines = f.readlines()
    
    for line_no, line in enumerate(lines, 1):
        if line.strip().startswith('%'):
            continue
        skip = False
        for sp in SKIP_PATTERNS:
            if re.search(sp, line):
                skip = True
                break
        if skip:
            continue
        
        for pattern, label in STAT_PATTERNS:
            for m in re.finditer(pattern, line, re.IGNORECASE):
                try:
                    value = float(m.group(1))
                    if label == 'p' and 1 < value < 10:
                        continue
                    if label == 'percent' and value > 100:
                        continue
                    if match_number(value, label, source_numbers):
                        traced += 1
                    else:
                        untraced.append((line_no, label, value, line.strip()[:80]))
                except ValueError:
                    continue
    
    return traced, untraced


def scan_untagged(paper_path):
    """Find statistical numbers without @source tags."""
    untagged = []
    with open(paper_path, encoding='utf-8', errors='ignore') as f:
        lines = f.readlines()
    
    for line_no, line in enumerate(lines, 1):
        if line.strip().startswith('%'):
            continue
        if '% @source:' in line:
            continue
        skip = False
        for sp in SKIP_PATTERNS:
            if re.search(sp, line):
                skip = True
                break
        if skip:
            continue
        
        for pattern, label in STAT_PATTERNS:
            for m in re.finditer(pattern, line, re.IGNORECASE):
                try:
                    value = float(m.group(1))
                    if label == 'p' and 1 < value < 10:
                        continue
                    if label == 'percent' and value > 100:
                        continue
                    untagged.append((line_no, label, value, line.strip()[:80]))
                except ValueError:
                    continue
    
    return untagged


# ═══════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════

def main():
    chdir_to_script()
    
    # Find paper
    if len(sys.argv) > 1:
        paper_path = sys.argv[1]
    else:
        tex_files = sorted(glob.glob('paper/main_K*.tex'), reverse=True)
        if not tex_files:
            tex_files = sorted(glob.glob('paper/*.tex'), reverse=True)
        if not tex_files:
            print("[ERROR] No .tex file found in paper/")
            return 1
        paper_path = tex_files[0]
    
    if not os.path.exists(paper_path):
        print(f"[ERROR] Paper not found: {paper_path}")
        return 1
    
    print("=" * 72)
    print("  Paper Checker v2.0 — Universal Verification")
    print(f"  Paper: {paper_path}")
    print("=" * 72)
    
    errors = 0
    
    # ── Load labels first ──
    labels = load_labels()
    
    # ── Layer 0: Data lineage ──
    print("\n[0/3] Data lineage check ...")
    lineage_errors = 0
    if labels is not None:
        meta = labels.get('_meta', {})
        expected_inputs = meta.get('expected_inputs', {})
        for key, entry in labels.items():
            if key.startswith('_'):
                continue
            src_input = entry.get('source_input', '')
            src_script = entry.get('source_script', '')
            # Check source_input file exists
            if src_input:
                input_path = os.path.join('output', src_input)
                if not os.path.exists(input_path):
                    print(f"      [!] {key}: source_input '{src_input}' not found in output/")
                    lineage_errors += 1
                else:
                    # Check if it's the expected file (from _meta)
                    if key in expected_inputs:
                        expected = expected_inputs[key]
                        if src_input != expected:
                            print(f"      [!] {key}: source_input is '{src_input}', expected '{expected}'")
                            print(f"          This label may be using WRONG input data!")
                            lineage_errors += 1
            # Warn if no source tracking at all
            if not src_input and not src_script:
                pass  # Many labels don't need this (e.g., derived values)
        
        # Also check: if expected_inputs is non-empty, verify ALL listed labels exist and match
        if expected_inputs:
            for exp_key, exp_file in expected_inputs.items():
                if exp_key not in labels:
                    print(f"      [!] _meta.expected_inputs references unknown label: {exp_key}")
                    lineage_errors += 1
                    
        # Warn if no expected_inputs defined at all (labels.json may be stale)
        no_lineage = sum(1 for k, v in labels.items() 
                        if not k.startswith('_') and v.get('source_input'))
        total_data_labels = sum(1 for k in labels if not k.startswith('_'))
        if total_data_labels > 10 and no_lineage == 0:
            print(f"      [!] 0/{total_data_labels} labels have source_input — lineage tracking not set up!")
            print(f"          Add source_script + source_input to each label in generate_labels.py")
        
        if lineage_errors == 0:
            print(f"      OK — all source_input files verified")
        else:
            print(f"      {lineage_errors} LINEAGE ERROR(S) — data may come from wrong source!")
        errors += lineage_errors
    else:
        print("      Skipped (no labels.json)")
    
    # ── Layer 1: Label verification ──
    print("\n[1/3] Label verification ...")
    
    if labels is None:
        print("      [!] output/labels.json not found.")
        print("      Run 'python generate_labels.py' first to create it.")
        print("      Skipping label checks.")
        lb = {'match': 0, 'mismatch': 0, 'missing': 0, 'manual': 0, 'details': []}
    else:
        print(f"      Loaded {len(labels)} labels from output/labels.json")
        lb = check_labels(paper_path, labels)
        print(f"      MATCH:  {lb['match']}")
        print(f"      MANUAL: {lb['manual']}")
        if lb['mismatch'] > 0:
            print(f"      MISMATCH: {lb['mismatch']}  <-- ERRORS")
            for d in lb['details']:
                print(f"        {d}")
            errors += lb['mismatch']
    
    # ── Layer 2: Number traceability ──
    print("\n[2/3] Number traceability ...")
    source_numbers = load_source_numbers()
    traced, untraced = check_numbers(paper_path, source_numbers)
    print(f"      Traced:  {traced}")
    print(f"      Orphan:  {len(untraced)}")
    
    if untraced:
        print("\n      --- Orphan numbers (no source in output/) ---")
        for line_no, label, value, ctx in untraced[:10]:
            print(f"      Line {line_no}: {label}={value}  {ctx}")
        if len(untraced) > 10:
            print(f"      ... and {len(untraced) - 10} more")
    errors += len(untraced)
    
    # ── Layer 3: Untagged numbers ──
    print("\n[3/3] Untagged numbers scan ...")
    untagged = scan_untagged(paper_path)
    print(f"      Without @source: {len(untagged)}")
    if untagged:
        for line_no, label, value, ctx in untagged[:5]:
            print(f"      Line {line_no}: {label}={value}  {ctx[:70]}")
        if len(untagged) > 5:
            print(f"      ... and {len(untagged) - 5} more")
        print(f"      Tip: Add % @source: <label> tags for full verification.")
    
    # ── Report ──
    print("\n" + "=" * 72)
    if errors == 0:
        print("  [PASS] All checks passed. Ready to submit.")
    else:
        print(f"  [FAIL] {errors} issue(s) found. Fix and re-run.")
        if lb.get('mismatch', 0) > 0:
            print(f"         Label mismatches: {lb['mismatch']}")
        if untraced:
            print(f"         Untraceable numbers: {len(untraced)}")
    print("=" * 72)
    print()
    
    return 1 if errors > 0 else 0


if __name__ == '__main__':
    sys.exit(main())
