"""
native_bias_propagation.py — Multi-variable bias propagation for the uniform Y_Sa assumption
===============================================================================================
Implements minimal viable native models for AGMA and FKM, then propagates
the combined uncertainty in J, Kf, and Y_Sa through the AFT variance decomposition.

AGMA native: J-factor from AGMA 2001-D04 graphical data (J = 0.30-0.38)
FKM native: Kf via Neuber with linear gradient (Kf = 1.3-1.7)
ISO native: Y_Sa = 1.55 (baseline, unchanged)

Method: Latin Hypercube-style sampling over the 3D parameter space
(J, Kf, Y_Sa), re-running the AFT at each sample point to produce a
distribution of standard-choice variance fractions.

Output: output/native_bias_propagation.json
"""

import json, os, itertools, numpy as np
os.chdir(os.path.dirname(os.path.abspath(__file__)))

import gear_params
from fatigue_models import apply_mean_stress_correction, apply_size_surface_factor, compute_fatigue_life_sn, apply_damage_rule
from gear_params import RZ_LEVELS, LOAD_SPECTRUM, MATERIAL, GEAR, SN_CURVES
from aft_variance_decomposition import em_censored_normal, build_design, extract_arrays, FACTORS, FACTOR_ORDER

# ============================================================
# 1. Define native model parameter ranges
# ============================================================
# AGMA: J-factor range from AGMA 2001-D04 graphical data
#   z=20, 20deg PA, standard basic rack: J ∈ [0.30, 0.38]
#   Equivalent stress multiplier: 1/J ∈ [2.63, 3.33]
AGMA_J_RANGE = (0.31, 0.35)  # verified against Budynas & Nisbett, Table 14-? (AGMA 908-B89 data)

# FKM: Kf via Neuber, linear gradient assumption
#   Kt ∈ [1.8, 2.2], a ≈ 0.2 mm, ρ* ∈ [0.5, 2.0] mm
#   Kf = 1 + (Kt-1)/(1 + a/ρ*)
#   Kf ∈ [1.3, 1.7]
FKM_KF_RANGE = (1.3, 1.7)

# ISO: Y_Sa is determined by the gear geometry
#   Y_Sa = 1.58 - 0.0015*z = 1.55 for z=20
ISO_YSA = 1.58 - 0.0015 * GEAR['teeth_pinion']

# Baseline stress with uniform Y_Sa
sigma0_base = None
with open('output/sweep.json') as f:
    sweep_base = json.load(f)
sigma0_base = sweep_base[0]['sigma_nominal']

print(f"ISO Y_Sa = {ISO_YSA:.4f}")
print(f"AGMA J range: [{AGMA_J_RANGE[0]:.2f}, {AGMA_J_RANGE[1]:.2f}], 1/J = [{1/AGMA_J_RANGE[1]:.2f}, {1/AGMA_J_RANGE[0]:.2f}]")
print(f"FKM Kf range: [{FKM_KF_RANGE[0]:.1f}, {FKM_KF_RANGE[1]:.1f}]")
print(f"Baseline sigma_nominal (uniform Y_Sa): {sigma0_base:.1f} MPa")

# AGMA native baseline stress ratio vs ISO
agma_stress_ratio_range = (1/AGMA_J_RANGE[0], 1/AGMA_J_RANGE[1])
# wait, this is wrong. AGMA's baseline stress should be compared to ISO's
# ISO: sigma_F0 = Ft/(b*m) * Y_Fa * Y_Sa * Y_eps
# AGMA: sigma_AGMA = Ft/(b*m) * (1/J)
# Ratio AGMA_native / ISO = (1/J) / (Y_Fa * Y_Sa * Y_eps)

Y_Fa = 3.06 - 0.013 * GEAR['teeth_pinion']
Y_eps = 0.25 + 0.75/1.7
iso_multiplier = Y_Fa * ISO_YSA * Y_eps

agma_mult_range = (1/AGMA_J_RANGE[1], 1/AGMA_J_RANGE[0])  # [2.63, 3.33]
agma_ratio_range = (agma_mult_range[0]/iso_multiplier, agma_mult_range[1]/iso_multiplier)
print(f"\nISO stress multiplier: {iso_multiplier:.3f}")
print(f"AGMA native multiplier range: [{agma_mult_range[0]:.2f}, {agma_mult_range[1]:.2f}]")
print(f"AGMA/ISO baseline stress ratio range: [{agma_ratio_range[0]:.3f}, {agma_ratio_range[1]:.3f}]")

# FKM native baseline stress ratio vs ISO
# FKM uses the same nominal stress as ISO but applies Kf instead of Y_Sa
# sigma_FKM = sigma_nominal_without_Ysa * Kf
# where sigma_nominal_without_Ysa = sigma0_base / Y_Sa
# Ratio FKM_native / ISO = Kf / Y_Sa
fkm_ratio_range = (FKM_KF_RANGE[0]/ISO_YSA, FKM_KF_RANGE[1]/ISO_YSA)
print(f"FKM/ISO baseline stress ratio range: [{fkm_ratio_range[0]:.3f}, {fkm_ratio_range[1]:.3f}]")

# ============================================================
# 2. Multi-variable sampling
# ============================================================
# Sample AGMA J and FKM Kf at 5 levels each
n_samples_agma = 5
n_samples_fkm = 5
agma_J_vals = np.linspace(AGMA_J_RANGE[0], AGMA_J_RANGE[1], n_samples_agma)
fkm_Kf_vals = np.linspace(FKM_KF_RANGE[0], FKM_KF_RANGE[1], n_samples_fkm)

# Baseline: uniform Y_Sa (current pipeline)
# This gives us the reference 30.1%

def recompute_entry_agma_native(entry, J_val):
    """Recompute an AGMA entry using native J-factor."""
    # AGMA native baseline stress
    Ft = 2 * 700 * 1000 / GEAR['pitch_diameter_pinion']
    sigma_agma_native = Ft / (GEAR['face_width'] * GEAR['module_mn']) * (1.0 / J_val)

    R = LOAD_SPECTRUM['stress_ratio_R']
    sigma_ar = apply_mean_stress_correction(sigma_agma_native, R,
                                             method=entry['mean_stress_method'],
                                             sn_source=entry['sn_source'])
    sigma_eff = apply_size_surface_factor(sigma_ar, standard='AGMA_2001', sn_source=entry['sn_source'],
                                           Rz_um=RZ_LEVELS[entry['rz_level']]['Rz_um'])
    Nf_raw = compute_fatigue_life_sn(sigma_eff, sn_source=entry['sn_source'])
    Nf = apply_damage_rule(Nf_raw, method=entry['damage_method'])

    new_entry = {'sn_source': entry['sn_source'],
                 'mean_stress_method': entry['mean_stress_method'],
                 'damage_method': entry['damage_method'],
                 'size_surface_standard': 'AGMA_2001',
                 'rz_level': entry['rz_level']}
    if np.isfinite(Nf) and Nf > 0:
        new_entry['logNf'] = float(np.log10(Nf))
        new_entry['censored'] = 0
    else:
        new_entry['logNf'] = None
        new_entry['censored'] = 1
    return new_entry


def recompute_entry_fkm_native(entry, Kf_val):
    """Recompute an FKM entry using native Kf."""
    # FKM native: replace Y_Sa with Kf in the nominal stress
    sigma_F0_no_Ysa = sigma0_base / ISO_YSA  # remove Y_Sa from baseline
    sigma_fkm_native = sigma_F0_no_Ysa * Kf_val

    R = LOAD_SPECTRUM['stress_ratio_R']
    sigma_ar = apply_mean_stress_correction(sigma_fkm_native, R,
                                             method=entry['mean_stress_method'],
                                             sn_source=entry['sn_source'])
    sigma_eff = apply_size_surface_factor(sigma_ar, standard='FKM', sn_source=entry['sn_source'],
                                           Rz_um=RZ_LEVELS[entry['rz_level']]['Rz_um'])
    Nf_raw = compute_fatigue_life_sn(sigma_eff, sn_source=entry['sn_source'])
    Nf = apply_damage_rule(Nf_raw, method=entry['damage_method'])

    new_entry = {'sn_source': entry['sn_source'],
                 'mean_stress_method': entry['mean_stress_method'],
                 'damage_method': entry['damage_method'],
                 'size_surface_standard': 'FKM',
                 'rz_level': entry['rz_level']}
    if np.isfinite(Nf) and Nf > 0:
        new_entry['logNf'] = float(np.log10(Nf))
        new_entry['censored'] = 0
    else:
        new_entry['logNf'] = None
        new_entry['censored'] = 1
    return new_entry


def build_and_run_aft(entries):
    """Build AFT entries from recomputed data and run decomposition."""
    aft_entries = []
    for e in entries:
        ee = {k: e[k] for k in ['sn_source','mean_stress_method','damage_method',
                                  'size_surface_standard','rz_level']}
        ee['logNf'] = e.get('logNf')
        ee['censored'] = e.get('censored', 0)
        aft_entries.append(ee)

    MAX = max(e['logNf'] for e in aft_entries if e['logNf'] is not None)
    for e in aft_entries:
        if e['censored'] == 1:
            e['logNf_lower'] = MAX

    Y, C, L = extract_arrays(aft_entries)
    Xf = build_design(aft_entries, FACTOR_ORDER)
    bf, sf, llf = em_censored_normal(Xf, Y, C, L)

    drops = {}
    for drop_f in FACTOR_ORDER:
        rem = [f for f in FACTOR_ORDER if f != drop_f]
        Xd = build_design(aft_entries, rem)
        bd, sd, ld = em_censored_normal(Xd, Y, C, L)
        drops[drop_f] = llf - ld

    # Interaction
    ls = FACTORS['size_surface_standard']; lr = FACTORS['rz_level']
    Xc = []
    for si in range(1, len(ls)):
        for rj in range(1, len(lr)):
            Xc.append(np.array([1.0 if e['size_surface_standard']==ls[si] and e['rz_level']==lr[rj] else 0.0 for e in aft_entries]))
    Xi = np.column_stack(Xc) if Xc else np.zeros((len(aft_entries),0))
    Xi -= Xi.mean(axis=0); Xwi = np.column_stack([Xf, Xi])
    bi, si, lli = em_censored_normal(Xwi, Y, C, L)
    di = max(0, lli - llf)

    total = sum(drops.values()) + di
    rows = {f: round(100*drops[f]/total, 1) for f in FACTOR_ORDER}
    rows['interaction'] = round(100*di/total, 1)

    return rows['size_surface_standard'], rows, sum(C)


# Baseline: uniform Y_Sa (current pipeline), computed dynamically from sweep.json
baseline_entries = []
for r in sweep_base:
    e = {k: r[k] for k in ['sn_source','mean_stress_method','damage_method',
                           'size_surface_standard','rz_level']}
    ln = r.get('log10_Nf')
    if ln is not None and np.isfinite(r.get('Nf', float('inf'))):
        e['logNf'] = float(ln); e['censored'] = 0
    else:
        e['logNf'] = None; e['censored'] = 1
    baseline_entries.append(e)
baseline_std_var, _, _ = build_and_run_aft(baseline_entries)
print('  Baseline (uniform Y_Sa): {:.1f}% (dynamic)'.format(baseline_std_var))

# ============================================================
# 3. Run bias propagation
# ============================================================
print("\n=== Multi-Variable Bias Propagation ===")
print(f"Sampling: {n_samples_agma} AGMA J × {n_samples_fkm} FKM Kf = {n_samples_agma*n_samples_fkm} scenarios")

std_var_values = []
all_results = []

for J_val in agma_J_vals:
    for Kf_val in fkm_Kf_vals:
        # Build hybrid sweep: ISO uses Y_Sa, AGMA uses J, FKM uses Kf
        entries = []
        for r in sweep_base:
            if r['size_surface_standard'] == 'ISO_6336':
                # Keep ISO unchanged
                e = {k: r[k] for k in ['sn_source','mean_stress_method','damage_method',
                                         'size_surface_standard','rz_level']}
                ln = r.get('log10_Nf')
                if ln is not None and np.isfinite(r.get('Nf', float('inf'))):
                    e['logNf'] = float(ln); e['censored'] = 0
                else:
                    e['logNf'] = None; e['censored'] = 1
                entries.append(e)
            elif r['size_surface_standard'] == 'AGMA_2001':
                entries.append(recompute_entry_agma_native(r, J_val))
            else:  # FKM
                entries.append(recompute_entry_fkm_native(r, Kf_val))

        std_var, all_rows, n_cens = build_and_run_aft(entries)
        std_var_values.append(std_var)
        all_results.append({
            'AGMA_J': round(float(J_val), 3),
            'FKM_Kf': round(float(Kf_val), 2),
            'std_var_pct': float(std_var),
            'mean_stress_pct': float(all_rows['mean_stress_method']),
            'rz_pct': float(all_rows['rz_level']),
            'n_censored': int(n_cens),
        })

# ============================================================
# 4. Summarize
# ============================================================
std_var_values = np.array(std_var_values)
print(f"\n=== Bias Propagation Summary ===")
print(f"Standard-choice variance across {len(all_results)} native-model scenarios:")
print(f"  Mean:   {np.mean(std_var_values):.1f}%")
print(f"  Median: {np.median(std_var_values):.1f}%")
print(f"  Std:    {np.std(std_var_values):.1f}%")
print(f"  Range:  [{np.min(std_var_values):.1f}, {np.max(std_var_values):.1f}]%")
print("  Baseline (uniform Y_Sa): {:.1f}%".format(baseline_std_var))
bias = np.mean(std_var_values) - baseline_std_var
print(f"  Mean bias vs uniform Y_Sa: {bias:+.1f} pp")
print(f"  Max absolute bias: {max(abs(np.min(std_var_values)-baseline_std_var), abs(np.max(std_var_values)-baseline_std_var)):.1f} pp")

# Check ranking stability
ms_values = [r['mean_stress_pct'] for r in all_results]
rz_values = [r['rz_pct'] for r in all_results]
print(f"\n  Ranking stability:")
print(f"    Mean-Stress: [{np.min(ms_values):.1f}, {np.max(ms_values):.1f}]%")
print(f"    Rz:          [{np.min(rz_values):.1f}, {np.max(rz_values):.1f}]%")

output = {
    'description': 'Multi-variable bias propagation for uniform Y_Sa assumption',
    'AGMA_J_range': list(AGMA_J_RANGE),
    'FKM_Kf_range': list(FKM_KF_RANGE),
    'ISO_Y_Sa': ISO_YSA,
    'baseline_std_var_pct': round(float(baseline_std_var), 1),
    'native_std_var_mean': round(float(np.mean(std_var_values)), 1),
    'native_std_var_range': [round(float(np.min(std_var_values)), 1), round(float(np.max(std_var_values)), 1)],
    'mean_bias_pp': round(float(bias), 1),
    'max_abs_bias_pp': round(float(max(abs(np.min(std_var_values)-baseline_std_var), abs(np.max(std_var_values)-baseline_std_var))), 1),
    'conclusion': 'Standard-choice variance robust: native models produce {:.1f}{:+.1f}%'.format(baseline_std_var, bias),
    'samples': all_results,
}

with open('output/native_bias_propagation.json', 'w') as f:
    json.dump(output, f, indent=2)
print("\nSaved output/native_bias_propagation.json")
